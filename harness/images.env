# The reference: wkhtmltopdf 0.12.6 (with patched Qt) on Alpine 3.24, from the image the published
# figures for marqius-wkhtmltopdf were measured in. Pinned by digest so every run uses the same
# system and the same fonts; Docker picks the amd64 or arm64 image from this index.
REFERENCE=surnet/alpine-wkhtmltopdf:3.24.3-0.12.6-full@sha256:ce8cbcdfd11a8f73ba0bb5a86301e17325c93a39485cf4165e3e99a08503dca9
# The same image for one platform each, used when run.sh is given --platform (Docker Desktop keeps
# one platform of an image under the index digest, so another platform needs its own digest)
REFERENCE_AMD64=surnet/alpine-wkhtmltopdf:3.24.3-0.12.6-full@sha256:2eea030700776ecfbf3feed6da965e88ae1e279697764f74c85b18eba51b93d4
REFERENCE_ARM64=surnet/alpine-wkhtmltopdf:3.24.3-0.12.6-full@sha256:9c42cad3536160c7fc4e093b0e211938019e7e834fef0a8a0371aa1a9458a1ee
# The program under test, unless --tag names another version
MARQIUS=marqius/wkhtmltopdf
DEFAULT_TAG=latest
